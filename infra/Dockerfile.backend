FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY backend ./backend
COPY infra ./infra
COPY scripts ./scripts
COPY data ./data
RUN pip install --no-cache-dir .

ENV PYTHONPATH=/app/backend
EXPOSE 8000
CMD ["sh", "-c", "python scripts/migrate.py && python scripts/seed_jobs.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"]

